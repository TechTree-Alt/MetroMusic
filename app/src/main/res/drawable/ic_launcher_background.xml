<?xml version="1.0" encoding="utf-8"?>
<!-- The tile the glyph sits on: WP8 cyan, the framework's default accent, with its lower-right half a
     shade deeper.

     Still flat — two solid fills meeting on the diagonal, no gradient — so it stays in the Metro
     idiom while giving the tile the faint fold a light source would put across it, which is what
     keeps a single-colour square from looking like a placeholder at launcher size. Drawn across the
     whole 108dp canvas, so whatever shape the launcher cuts out of it, there is no edge to find. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="@color/ic_launcher_background"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />
    <path
        android:fillColor="@color/ic_launcher_background_shade"
        android:pathData="M108,0 L108,108 L0,108 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon's glyph: two beamed quavers whose heads are squares — tiles — rather than ovals.

     Drawn in the Metro manner: flat white, straight edges, no outline, no shadow, the same weight
     throughout, sitting on a tile of accent colour (ic_launcher_background) the way every WP8 tile
     carried a single white mark. The square heads are the one liberty, and the point of it: the
     note is made out of the same thing the whole app is made out of.

     Placed by the adaptive-icon rules, not by eye on a square. A launcher may cut the 108dp canvas
     to any shape that contains the middle 66dp circle, so every corner of the glyph is within 28dp
     of the centre — clear of that circle with room to spare under a round mask, and centred on its
     own bounding box so it sits in the middle of a squircle, a teardrop or a square alike. Five
     shapes in one colour, so the same paths serve as the themed-icon layer (ic_launcher_monochrome).

     Two squares, two bars and a parallelogram, so it is edited by hand; change the monochrome layer
     in the same breath. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- first note's head -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M37.20,64.00 L49.20,64.00 L49.20,76.00 L37.20,76.00 Z" />
    <!-- second note's head -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M58.80,59.20 L70.80,59.20 L70.80,71.20 L58.80,71.20 Z" />
    <!-- first stem -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M45.60,36.80 L49.20,36.80 L49.20,64.00 L45.60,64.00 Z" />
    <!-- second stem -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M67.20,32.00 L70.80,32.00 L70.80,59.20 L67.20,59.20 Z" />
    <!-- beam -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M45.60,36.80 L70.80,32.00 L70.80,38.80 L45.60,43.60 Z" />
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon layer (Android 13+): the glyph alone, for the launcher to tint with the colours
     of the wallpaper. The very same paths as ic_launcher_foreground — a single flat white mark is
     already what a monochrome layer asks for, which is one more reason the icon is drawn that way.
     Keep the two identical. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- first note's head -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M37.20,64.00 L49.20,64.00 L49.20,76.00 L37.20,76.00 Z" />
    <!-- second note's head -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M58.80,59.20 L70.80,59.20 L70.80,71.20 L58.80,71.20 Z" />
    <!-- first stem -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M45.60,36.80 L49.20,36.80 L49.20,64.00 L45.60,64.00 Z" />
    <!-- second stem -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M67.20,32.00 L70.80,32.00 L70.80,59.20 L67.20,59.20 Z" />
    <!-- beam -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M45.60,36.80 L70.80,32.00 L70.80,38.80 L45.60,43.60 Z" />
</vector>
